<!-- 
  Custom Wazuh Detection Rules
  Author: Rahul Yadav
  Project: SOC Analyst Home Lab
  Date: 2026-06-05
  
  Rules cover:
  - Brute force detection via Windows Security EID 4625
  - Post-brute-force successful login detection
  - Mimikatz execution detection via Sysmon
  - LSASS memory access detection via Sysmon EID 10
-->

<group name="windows,brute_force,authentication">

  <!-- Rule 1: Brute Force Detection
       Fires when the same source generates 5+ failed logons within 60 seconds.
       Stacks on top of built-in rule 92000 (Windows failed logon EID 4625).
       Level 10 = High severity. -->
  <rule id="100001" level="10" frequency="5" timeframe="60">
    <if_matched_sid>92000</if_matched_sid>
    <description>Possible brute force: 5+ failed logons in 60 seconds</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>brute_force,authentication_failures</group>
  </rule>

  <!-- Rule 2: Successful Login After Brute Force
       Fires when a successful logon (EID 4624) occurs after multiple failures.
       Indicates the brute force may have succeeded.
       Level 14 = Critical — attacker may have gained access. -->
  <rule id="100002" level="14">
    <if_sid>92000</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <description>Successful logon after multiple failures - possible brute force success</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>brute_force,authentication_success</group>
  </rule>

  <!-- Rule 3: Mimikatz Execution Detected
       Uses Sysmon original filename field — catches renamed mimikatz binaries.
       Attackers often rename mimikatz.exe to evade detection.
       Sysmon reads the PE header original name, not the running process name.
       Level 15 = Maximum severity. -->
  <rule id="100003" level="15">
    <if_group>sysmon</if_group>
    <field name="win.eventdata.originalFileName">(?i)mimikatz</field>
    <description>Mimikatz execution detected - credential dumping attempt</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping</group>
  </rule>

  <!-- Rule 4: LSASS Memory Access via Sysmon
       Sysmon EID 10 (ProcessAccess) fires when one process reads another's memory.
       Any process accessing lsass.exe memory is attempting credential theft.
       Level 15 = Maximum severity. -->
  <rule id="100004" level="15">
    <if_group>sysmon</if_group>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage">(?i)lsass.exe</field>
    <description>LSASS memory access detected - possible credential dumping</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping</group>
  </rule>

</group>
